{
  "name": "glualint-ls",
  "version": "0.2.2",
  "description": "Language server wrapper for glualint.",
  "keywords": [
    "glua",
    "gmod",
    "garrysmod",
    "lua",
    "lsp",
    "language-server",
    "linter",
    "glualint"
  ],
  "license": "MIT",
  "author": "Dragoteryx",
  "homepage": "https://github.com/Dragoteryx/glualint-ls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragoteryx/glualint-ls.git"
  },
  "bugs": {
    "url": "https://github.com/Dragoteryx/glualint-ls/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "glualint-ls": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2"
  }
}
